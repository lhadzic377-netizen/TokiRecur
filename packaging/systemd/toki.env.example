# Toki Recur daemon configuration
#
# This file is loaded by systemd as EnvironmentFile=. Each line is
# KEY=VALUE. Lines starting with # are comments.
#
# Permissions: chmod 600, owned by root:toki.
# Path:        /etc/toki-recur/toki.env

# ---- Required ----

# Bearer token required by clients calling the API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKI_AUTH_TOKEN=

# ---- Optional ----

# llama-server backend URL.
#TOKI_BACKEND_URL=http://127.0.0.1:8088

# Path for the embedding index SQLite database.
#TOKI_DB=/var/lib/toki-recur/index.sqlite

# Path for KV cache blob storage (if save/restore is ever re-enabled).
#TOKI_CACHE_DIR=/var/lib/toki-recur/blobs

# Cosine similarity threshold for cache lookup.
#TOKI_SIMILARITY_THRESHOLD=0.85

# Memory budget in MB.
#TOKI_MEMORY_BUDGET_MB=8192

# Logging level (DEBUG, INFO, WARNING, ERROR).
#TOKI_LOG_LEVEL=INFO

# Rate limiting (requests per minute burst / sustained refill).
#TOKI_RATE_LIMIT_BURST=60
#TOKI_RATE_LIMIT_RATE=1.0

# ---- Web UI (toki-recur-web.service) ----
#
# The web UI shares TOKI_AUTH_TOKEN: when set, the whole UI is gated
# behind a login page and the session cookie is HMAC-signed with it.
# Leave empty to run the UI without login (localhost only).

# Backend URLs the web UI talks to.
#TOKI_WEB_RAW_URL=http://127.0.0.1:8088
#TOKI_WEB_DAEMON_URL=http://127.0.0.1:8787

# TLS: give both cert and key to serve HTTPS + wss:// (cookie gets the
# Secure flag automatically). Over TLS use --host 0.0.0.0 or a
# reverse-proxied domain in the unit; on plain HTTP keep it bound to
# localhost, otherwise the token travels in cleartext.
#TOKI_WEB_TLS_CERT=/etc/toki-recur/tls/toki-recur.pem
#TOKI_WEB_TLS_KEY=/etc/toki-recur/tls/toki-recur.key
