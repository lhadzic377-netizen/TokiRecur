[Unit]
Description=Toki Recur web UI (chat interface on 127.0.0.1:7777)
Documentation=https://github.com/lhadzic377-netizen/TokiRecur
After=network-online.target toki-recur.service
Wants=network-online.target
Requires=toki-recur.service

[Service]
Type=simple
User=toki
Group=toki

WorkingDirectory=/var/lib/toki-recur
RuntimeDirectory=toki-recur
LogsDirectory=toki-recur

# Secrets + backend URLs. TOKI_WEB_RAW_URL / TOKI_WEB_DAEMON_URL and
# optionally TOKI_WEB_TLS_CERT / TOKI_WEB_TLS_KEY / TOKI_WEB_TLS.
# TOKI_AUTH_TOKEN here gates the web UI behind the login page.
EnvironmentFile=/etc/toki-recur/toki.env

# Same explicit paths as the daemon: the web UI reads the registry and the
# auth token from the config directory.
Environment=HOME=/var/lib/toki-recur
Environment=XDG_CONFIG_HOME=/var/lib/toki-recur/.config
Environment=XDG_STATE_HOME=/var/lib/toki-recur/.local/state

ExecStart=/usr/bin/toki web \
    --host 127.0.0.1 \
    --port 7777

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening — same posture as the daemon unit.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
