# Toki Recur — Caddyfile (generated by scripts/install-site.sh)
# {{DOMAIN}} serves the landing site, {{CHAT_DOMAIN}} proxies the live chat UI.

{
    email {{EMAIL}}
}

{{DOMAIN}} {
    root * /opt/toki-site/www
    encode zstd gzip
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Cache-Control "no-cache"
        -Server
    }
}

{{CHAT_DOMAIN}} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:7777
}
