# Toki Recur — the block install-site.sh manages.
#
# The installer does not own this file, only these two regions: everything
# outside the BEGIN/END markers belongs to whatever else runs on the machine
# and is left exactly as it was found. {{DOMAIN}} serves the built static
# site; {{CHAT_DOMAIN}} proxies the web chat.
#
# The global block has to be the first thing in the file, so it is its own
# region: the installer puts it at the top and the site blocks at the end.

# TOKI_GLOBAL_BEGIN
{
    email {{EMAIL}}
}
# TOKI_GLOBAL_END

# TOKI_SITE_BEGIN

# Canonical host. The installer removes this block when the main domain is
# already the www host.
# WWW_BEGIN
{{WWW_DOMAIN}} {
    redir https://{{DOMAIN}}{uri} permanent
}
# WWW_END

{{DOMAIN}} {
    root * {{WWW_ROOT}}
    encode zstd gzip

    # HTML must revalidate; fingerprinted assets can live forever.
    @html path / *.html /docs/ /docs/*.html
    header @html Cache-Control "no-cache"

    @assets path /img/* /assets/* /fonts/* /style.css /head.js /app.js /tui.js /favicon.png /favicon.ico /docs/docs.css /docs/docs.js
    header @assets Cache-Control "public, max-age=31536000, immutable"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # /pricing -> pricing.html, /docs/ -> docs/index.html, and a real 404.
    try_files {path} {path}.html {path}/index.html
    file_server

    handle_errors {
        rewrite * /404.html
        file_server
    }
}

# CHAT_BEGIN
{{CHAT_DOMAIN}} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:7777

    # The chat UI is its own app with its own assets, so it does not get the
    # site's CSP. These three do not break it.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
# CHAT_END

# TOKI_SITE_END
