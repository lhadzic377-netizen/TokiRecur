/* Toki Recur TUI — black + yellow, monospace, semantic status colors */

Screen {
    background: #000000;
    color: #f0ece0;
}

#main-area {
    height: 1fr;
}

#chat-container {
    height: 1fr;
    padding: 1 2;
    background: #000000;
}

#chat {
    height: 1fr;
    background: #000000;
    border: round #2b2b2b;
    padding: 0 1;
    scrollbar-color: #3d3d3d #000000;
    scrollbar-size-vertical: 1;
}

#chat:focus-within {
    border: round #2b2b2b;
}

#input {
    dock: bottom;
    margin: 0 1;
    background: #121212;
    border: round #3d3d3d;
    height: 3;
}

#input:focus {
    border: round #ffd60a;
}

#sidebar {
    background: #121212;
    border-right: round #3d3d3d;
    width: 22;
}

#info {
    background: #121212;
    border-left: round #3d3d3d;
}

#status-bar {
    dock: bottom;
    background: #000000;
    color: #9a967f;
    border-top: round #3d3d3d;
    height: 1;
    padding: 0 1;
}
