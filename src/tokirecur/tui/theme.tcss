/* Toki Recur TUI — black + yellow, monospace, semantic status colors */

Screen {
    background: #000000;
    color: #f0ece0;
}

#main-area {
    height: 1fr;
}

#chat-container {
    height: 1fr;
    padding: 1 2;
    background: #000000;
}

#chat {
    height: 1fr;
    background: #000000;
    border: round #2b2b2b;
    padding: 0 1;
    scrollbar-color: #3d3d3d #000000;
    scrollbar-size-vertical: 1;
}

#chat:focus-within {
    border: round #2b2b2b;
}

#bottom-panel {
    /* The bar and the prompt, stacked. Two bottom-docked widgets would
       both be placed at the bottom edge and would overlap. */
    dock: bottom;
    height: 5;
    background: #121212;
}

#input {
    dock: none;
    margin: 0 1;
    background: #121212;
    border: round #3d3d3d;
    height: 3;
}

#input:focus {
    border: round #ffd60a;
}

#sidebar {
    background: #121212;
    border-right: round #3d3d3d;
    width: 22;
}

#info {
    background: #121212;
    border-left: round #3d3d3d;
}

#status-bar {
    dock: none;
    background: #000000;
    color: #9a967f;
    border-top: round #3d3d3d;
    /* Two rows, not one: the border-top takes a row of its own, and a
       height of 1 left the content box with nothing to draw in — the
       whole footer (mode, session, hit rate) had been rendering as an
       empty strip at the bottom of the screen. */
    height: 2;
    padding: 0 1;
}
