/* Toki Recur TUI — themed by variables, not by colours.
 *
 * Every colour here is a variable: Textual's own design tokens
 * ($background, $surface, $text, $primary, $border) plus the slots
 * Textual has no name for ($muted, $border-hi, $accent-dim). They are
 * resolved from the active palette, so this file is the same for every
 * theme and no colour is ever frozen into it. */

Screen {
    background: $background;
    color: $text;
}

#main-area {
    height: 1fr;
}

#chat-container {
    height: 1fr;
    padding: 1 2;
    background: $background;
}

#chat {
    height: 1fr;
    background: $background;
    border: round $border;
    padding: 0 1;
    scrollbar-color: $border-hi $background;
    scrollbar-size-vertical: 1;
}

#chat:focus-within {
    border: round $border-hi;
}

#bottom-panel {
    /* The bar and the prompt, stacked. Two bottom-docked widgets would
       both be placed at the bottom edge and would overlap. */
    dock: bottom;
    height: 5;
    background: $surface;
}

#input {
    dock: none;
    margin: 0 1;
    background: $surface;
    border: round $border-hi;
    height: 3;
}

#input:focus {
    border: round $primary;
}

#sidebar {
    background: $surface;
    border-right: round $border-hi;
    width: 22;
}

#info {
    background: $surface;
    border-left: round $border-hi;
}

#status-bar {
    dock: none;
    background: $background;
    color: $muted;
    border-top: round $border-hi;
    /* Two rows, not one: the border-top takes a row of its own, and a
       height of 1 left the content box with nothing to draw in — the
       whole footer (mode, session, hit rate) had been rendering as an
       empty strip at the bottom of the screen. */
    height: 2;
    padding: 0 1;
}
